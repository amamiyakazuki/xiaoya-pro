{
  "manifest_version": 3,
  "name": "小雅刷课助手",
  "version": "0.5.0",
  "minimum_chrome_version": "120",
  "description": "小雅任务面板、视频与课件队列、个人 AI 答案和批量作答。",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://whut.ai-augmented.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://whut.ai-augmented.com/app/jx-web/*"
      ],
      "js": [
        "background-mode.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://whut.ai-augmented.com/app/jx-web/*"
      ],
      "js": [
        "task-timing.js",
        "content.js",
        "ai-question.js",
        "answer-dom.js",
        "answer-media.js",
        "answer-float.js",
        "answer-batch.js",
        "answer-page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
